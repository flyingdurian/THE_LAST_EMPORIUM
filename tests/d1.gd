extends SceneTree
const Shell = preload("res://ui/GateC.tscn")
const Shop = preload("res://domain/shop.gd")
const Assets = preload("res://ui/d1_assets.gd")
var failed := 0
func check(ok: bool, name: String) -> void:
	if ok: print("PASS ",name)
	else: failed+=1; printerr("FAIL ",name)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var ui = Shell.instantiate()
	root.add_child(ui)
	ui.shop=Shop.new(Assets.content(),"user://d1_test.json")
	ui.ui_save_path="user://d1_ui_test.json"
	ui.refresh()
	check(ui.shop.snapshot().items.size()==3,"three unique merchandise")
	var initial: Dictionary=ui.shop.snapshot()
	ui.switch_view("stockroom"); ui.switch_view("floor"); ui.switch_view("counter")
	check(initial==ui.shop.snapshot(),"three-view navigation pure")
	ui.command("move",{"location":"shelf:0"})
	ui.command("move_fixture",{"fixture":"shelf","socket":"southwest"})
	check(ui.shop.snapshot().fixtures.shelf=="southwest" and ui.shop.snapshot().item.location=="shelf:0","fixture move retains item slot")
	var before: Dictionary=ui.shop.snapshot()
	ui.command("move_fixture",{"fixture":"shelf","socket":"east"})
	check(ui.shop.snapshot()==before,"occupied socket rejected")
	ui.command("select",{"item":"i_sword_001"})
	before=ui.shop.snapshot()
	ui.command("move",{"location":"shelf:1"})
	check(ui.shop.snapshot()==before,"incompatible shelf rejected")
	ui.command("move",{"location":"shelf:2"})
	ui.command("select",{"item":"i_shield_001"})
	ui.command("move",{"location":"shelf:3"})
	check(ui.shop.snapshot().item.location=="shelf:3","shield placed")
	ui.switch_view("stockroom"); ui.save_game(); ui.switch_view("floor"); ui.load_game()
	check(ui.view=="stockroom" and ui.shop.snapshot().fixtures.shelf=="southwest" and ui.shop.snapshot().items.size()==3,"layout and room persistence")
	ui.switch_view("counter")
	check(ui.item_stage.size==Vector2(470,282),"large item stage")
	ui.command("select",{"item":"i_dragon_001"}); ui.command("appraise"); ui.command("open"); ui.command("visit")
	ui.price_value=650; ui.act("evidence","Appraisal",true); ui.act("reassure","Fair offer",true)
	before=ui.shop.snapshot()
	ui.switch_view("floor"); ui.switch_view("stockroom"); ui.switch_view("counter")
	check(ui.shop.snapshot()==before and before.session.status=="pending","pending offer survives all rooms")
	ui.confirm()
	check(ui.shop.snapshot().gold==770 and ui.shop.snapshot().item.owner==ui.shop.snapshot().customer.id,"actual sale removes ownership")
	check(ui.shop.snapshot().items["i_sword_001"].owner=="shop","other merchandise unaffected")
	var legacy = Shop.new({},"user://d1_legacy_test.json")
	legacy.command({"type":"move","location":"shelf:3"})
	legacy.save()
	var migrated = Shop.new(Assets.content(),"user://d1_legacy_test.json")
	check(migrated.load_save().ok and migrated.snapshot().items.size()==3 and migrated.snapshot().item.owner=="shop","legacy stock migration preserves ownership")
	for p in ["user://d1_legacy_test.json","user://d1_legacy_test.json.bak","user://d1_test.json","user://d1_test.json.bak","user://d1_test.json.tmp","user://d1_ui_test.json"]: DirAccess.remove_absolute(ProjectSettings.globalize_path(p))
	print("D1 failures: ",failed)
	quit(failed)
