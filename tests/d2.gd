extends SceneTree
const Shell = preload("res://ui/GateC.tscn")
const Shop = preload("res://domain/shop.gd")
const Assets = preload("res://ui/d1_assets.gd")
const P = preload("res://ui/d2_presentation.gd")
var failed := 0
func check(ok: bool, name: String) -> void:
	if ok: print("PASS ",name)
	else: failed+=1; printerr("FAIL ",name)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var ui = Shell.instantiate(); root.add_child(ui)
	ui.shop = Shop.new(Assets.content(),"user://d2_test.json"); ui.ui_save_path="user://d2_ui_test.json"; ui.dialogue_speed=0; ui.refresh()
	var initial: Dictionary=ui.shop.snapshot()
	ui.switch_view("counter")
	check(ui.counter_room.texture.resource_path.ends_with("counter_room.jpg") and ui.counter_surface.texture.resource_path.ends_with("counter_surface.jpg"),"empty inspection uses physical counter")
	check(ui.portrait==null and initial==ui.shop.snapshot(),"inspection is pure and no fake shoppers")
	ui.command("select",{"item":"i_sword_001"})
	check(ui.item_stage.texture.resource_path.ends_with("sword_counter.png") and ui.item_stage.texture.get_width()>ui.item_stage.texture.get_height()*2,"horizontal sword staging")
	ui.command("move",{"location":"shelf:2"})
	ui.command("select",{"item":"i_shield_001"}); ui.command("move",{"location":"shelf:3"})
	check(ui.item_stage.texture.resource_path.ends_with("shield.png"),"shield uses distinct stage asset")
	ui.command("select",{"item":"i_dragon_001"}); ui.command("move",{"location":"shelf:0"}); ui.command("appraise")
	ui.switch_view("floor")
	check(ui.floor_items["i_dragon_001"].size.y==48 and ui.floor_items["i_sword_001"].size.x==82,"separate shelf-scale and rack-scale")
	ui.switch_view("counter")
	check(ui.counter_items.has("i_sword_001") and ui.counter_items.has("i_shield_001") and not ui.counter_items.has("i_dragon_001"),"selective true background projection")
	ui.command("open"); ui.command("visit")
	check(ui.portrait!=null and ui.portrait.texture.resource_path.ends_with("neutral.png"),"real encounter enters neutral portrait")
	ui.price_value=650; ui.act("evidence","Appraised",true); ui.act("reassure","Fair",true)
	check(ui.portrait.texture.resource_path.ends_with("pleased.png") and ui.shop.snapshot().session.status=="pending","resolved emotion selects pleased")
	var pending: Dictionary=ui.shop.snapshot(); ui.ledger=true; ui.refresh(); ui.switch_view("floor")
	check(not ui.floor_items.has("i_dragon_001") and ui.floor_items.has("i_sword_001"),"active stage hides only selected from display")
	ui.switch_view("counter"); ui.switch_view("stockroom"); ui.switch_view("counter")
	check(ui.shop.snapshot()==pending and ui.ledger and ui.item_stage!=null,"ledger and three views preserve pending")
	ui.confirm(); var settled: Dictionary=ui.shop.snapshot(); ui.confirm()
	check(settled==ui.shop.snapshot() and settled.gold==770 and settled.receipts.size()==1,"settlement once")
	ui.switch_view("floor"); check(not ui.floor_items.has("i_dragon_001"),"sold object absent from floor")
	ui.command("close"); ui.command("next_day"); ui.command("open"); ui.command("visit")
	check(P.presence(ui.shop.snapshot())=="social" and ui.portrait!=null and ui.shop.snapshot().return_note.contains("fairness"),"real returning customer present with memory")
	ui.save_game(); var saved: Dictionary=ui.shop.snapshot(); ui.switch_view("floor"); ui.load_game()
	check(saved==ui.shop.snapshot() and ui.view=="counter" and ui.portrait!=null,"return presentation reload")
	# New offline turn uses typewriter; instant skip never changes state.
	ui.shop.reset(); ui.history=[]; ui.command("move",{"location":"shelf:0"}); ui.command("open"); ui.dialogue_speed=1; ui.command("visit")
	var before: Dictionary=ui.shop.snapshot()
	check(ui.dialogue_label.visible_characters==0,"typewriter starts on new response")
	ui.skip_dialogue(); check(ui.dialogue_label.visible_characters==-1 and before==ui.shop.snapshot(),"typewriter skip presentation only")
	ui.act("insult","Rude")
	check(ui.portrait.texture.resource_path.ends_with("offended.png"),"offended state selects distinct portrait")
	for p in ["user://d2_test.json","user://d2_test.json.bak","user://d2_test.json.tmp","user://d2_ui_test.json"]: DirAccess.remove_absolute(ProjectSettings.globalize_path(p))
	print("D2 failures: ",failed); quit(failed)
