extends SceneTree
const Shell=preload("res://ui/Week.tscn")
const Week=preload("res://domain/week_shop.gd")
var failed:=0
var passed:=0
func check(ok: bool,name: String) -> void:
	if ok: passed+=1; print("PASS ",name)
	else: failed+=1; printerr("FAIL ",name)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var ui=Shell.instantiate(); root.add_child(ui)
	ui.shop=Week.new("user://week_ui_test.json"); ui.ui_save_path="user://week_ui_test_sidecar.json"; ui.refresh()
	ui.switch_view("stockroom"); ui.command("appraise"); ui.command("restock")
	check(ui.shop.snapshot().items.week_dragonstone.location=="shelf:0","actual Week stockroom prepares display")
	ui.switch_view("floor"); ui.command("open"); ui.open_counter()
	check(ui.shop.snapshot().customer.id=="vessa_rook" and is_instance_valid(ui.portrait),"actual customer portrait")
	ui.price_value=650; ui.act("evidence","Appraisal",true); ui.act("reassure","Fair offer",true)
	var before: Dictionary=ui.shop.snapshot()
	ui.ledger=true; ui.refresh(); ui.switch_view("stockroom"); ui.switch_view("floor"); ui.switch_view("counter")
	check(ui.shop.snapshot()==before and ui.ledger,"week offer and ledger continuity")
	ui.save_game(); ui.switch_view("floor"); ui.load_game()
	check(ui.shop.snapshot()==before and ui.view=="counter","week UI save/reload")
	ui.confirm(); ui.command("next_customer"); ui.open_counter()
	check(ui.shop.snapshot().visit_goal=="sell" and is_instance_valid(ui.portrait) and is_instance_valid(ui.item_stage),"seller and real offered merchandise")
	check(ui.provider_line(ui.shop.snapshot()).contains("sell") and ui.deal_text(ui.shop.snapshot())=="Pay 65g","direction-aware readable purchase")
	ui.act("accept_offer","Review purchase")
	before=ui.shop.snapshot()
	check(before.session.status=="pending" and before.gold==950,"purchase pending in UI")
	ui.confirm()
	check(ui.shop.snapshot().gold==885 and ui.shop.snapshot().item.owner=="shop","UI purchase settlement")
	ui.command("close")
	check(ui.drawer=="report" and ui.shop.snapshot().reports.size()==1,"actual closing ledger")
	ui.command("next_day"); ui.command("open"); ui.open_counter()
	check(ui.shop.snapshot().customer.id=="marla_fen" and is_instance_valid(ui.portrait),"different customer after day advance")
	ui.act("end","Until next time."); ui.command("next_customer"); ui.open_counter(); ui.act("end","Good day."); ui.command("close"); ui.command("next_day"); ui.command("open"); ui.open_counter()
	check(ui.shop.snapshot().visit_goal=="barter" and ui.shop.snapshot().customer.id=="bram_alder","actual barter visit Day 3")
	ui.act("barter","Let us trade."); before=ui.shop.snapshot(); ui.ledger=true; ui.refresh()
	check(before.session.status=="pending" and before.reservation.has("terms") and ui.deal_text(before).contains("Warding Tome"),"barter terms readable with ledger")
	ui.switch_view("stockroom"); ui.switch_view("counter"); ui.confirm(); check(ui.shop.snapshot().items.week_knights_blade.owner=="bram_alder","actual barter settlement")
	for p in ["user://week_ui_test.json","user://week_ui_test.json.bak","user://week_ui_test_sidecar.json"]: DirAccess.remove_absolute(ProjectSettings.globalize_path(p))
	print("WEEK UI RESULT: ",passed," passed, ",failed," failed")
	quit(failed)
